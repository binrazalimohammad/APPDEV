{
  "name": "BinRazali",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8000 tcp:8000 && react-native run-android",
    "android:no-reverse": "react-native run-android",
    "android:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8000 tcp:8000",
    "server": "node server.js",
    "android:usb": "npm run sync:pc-ip && npm run android:reverse && react-native run-android",
    "sync:pc-ip": "node scripts/sync-pc-ip.js",
    "android:sha1": "keytool -list -v -keystore android/app/debug.keystore -alias androiddebugkey -storepass android -keypass android",
    "google:redirect-uris": "node scripts/google-redirect-uris.js",
    "google:setup": "node scripts/open-google-oauth-console.js",
    "casaclick:serve": "node server.js",
    "casaclick:serve:local": "cd ../../websitedev && php -S 127.0.0.1:8000 -t public",
    "casaclick:serve:appdev": "cd ../casaclick && php -S 0.0.0.0:8000 -t public",
    "casaclick:fixtures": "cd ../../websitedev && php bin/console doctrine:fixtures:load --no-interaction",
    "api:ping": "node scripts/api-ping.js",
    "generate:icons": "node scripts/generate-android-icons.mjs",
    "android:release": "cd android && gradlew.bat assembleRelease",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest --passWithNoTests --forceExit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native/new-app-screen": "0.83.1",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/stack": "^7.8.4",
    "@reduxjs/toolkit": "^2.12.0",
    "react": "19.2.0",
    "react-native": "0.83.1",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.24.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-saga": "^1.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "redux-logger": "^3.0.6",
    "sharp": "^0.33.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
