# Copy to keystore.properties and fill in your release keystore details.
# Generate a keystore once:
#   keytool -genkeypair -v -storetype PKCS12 -keystore app/binrazali-release.keystore -alias binrazali -keyalg RSA -keysize 2048 -validity 10000

storeFile=binrazali-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=binrazali
keyPassword=YOUR_KEY_PASSWORD
